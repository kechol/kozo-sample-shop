# Local development only. The credentials match docker-compose.yml and are not secrets.
DATABASE_URL=postgres://shop:shop@localhost:5433/shop
# The fake payment provider in services/fake-payments accepts this test-only key.
PAYMENTS_URL=http://127.0.0.1:4010
PAYMENTS_SECRET_KEY=fp_test_local_fake_payments
# Signs session cookies. Any long random string works locally; never reuse it elsewhere.
BETTER_AUTH_SECRET=local-development-only-change-me-0000000000
BETTER_AUTH_URL=http://localhost:3000
